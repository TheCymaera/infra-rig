{
	"name": "@heledron/example-bun",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.5",
	"engines": {
		"bun": ">=1.4.5"
	},
	"scripts": {
		"dev": "docker compose -f compose.yaml -f compose.dev.yaml up --build",
		"dev:down": "docker compose -f compose.yaml -f compose.dev.yaml down --remove-orphans",
		"dev:native": "bun --hot src/index.ts",
		"start": "bun src/index.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@heledron/infra-rig": "link:../../packages/infra-rig",
		"@types/bun": "^1.4.5",
		"typescript": "^6.0.3"
	}
}
